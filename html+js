<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Metal Stok ve İş Emri Veri Simülatörü</title>
    <!-- Barkod kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #f4f7f6; }
        .container { display: flex; gap: 20px; max-width: 1200px; margin: auto; }
        .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .form-card { flex: 1; }
        .table-card { flex: 2; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; font-size: 14px; }
        th { background: #2c3e50; color: white; }
        input, select { width: 100%; padding: 8px; margin: 5px 0 15px; box-sizing: border-box; }
        .btn { background: #27ae60; color: white; border: none; padding: 10px; cursor: pointer; border-radius: 4px; width: 100%; font-size: 15px; }
        .btn:hover { background: #219653; }
    </style>
</head>
<body>

<h2 style="text-align: center; color: #2c3e50;">Metal Sanayi İş Emri & Veri Simülasyon Paneli</h2>

<div class="container">
    <!-- İş Emri Formu -->
    <div class="card form-card">
        <h3>Yeni İş Emri Oluştur</h3>
        <form id="isEmriForm">
            <label>Metal Malzeme / Cinsi:</label>
            <select id="malzemeAdi" required>
                <option value="3mm DKP Sac (ST37)">3mm DKP Sac (ST37)</option>
                <option value="4mm S235JR Sac">4mm S235JR Sac</option>
                <option value="40x40 Kutu Profil">40x40 Kutu Profil</option>
                <option value="10mm Lama Demir">10mm Lama Demir</option>
            </select>

            <label>Müşteri / Proje:</label>
            <input type="text" id="musteriAdi" placeholder="Örn: Çelik Makine A.Ş." required>

            <label>Kesim Ölçüsü (mm):</label>
            <input type="text" id="kesimOlcusu" placeholder="Örn: 500x1200 mm" required>

            <label>Adet:</label>
            <input type="number" id="adet" value="1" min="1" required>

            <button type="submit" class="btn">İş Emri Ver & Barkod Üret</button>
        </form>
    </div>

    <!-- Oluşturulan Verilerin Listesi -->
    <div class="card table-card">
        <h3>Simüle Edilen İş Emirleri ve Barkodlar</h3>
        <table>
            <thead>
                <tr>
                    <th>İş Emri No</th>
                    <th>Malzeme</th>
                    <th>Müşteri</th>
                    <th>Ölçü / Adet</th>
                    <th>Barkod</th>
                </tr>
            <thead id="isEmriListesi">
                <!-- Veriler JavaScript ile buraya eklenecek -->
            </thead>
        </table>
    </div>
</div>

<script>
    // Sayfa açıldığında hafızadaki verileri yükle
    let isEmirleri = JSON.parse(localStorage.getItem('metal_is_emirleri')) || [];

    function listeyiGoster() {
        const tbody = document.getElementById('isEmriListesi');
        tbody.innerHTML = '';

        if(isEmirleri.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:#7f8c8d;">Henüz veri oluşturulmadı.</td></tr>';
            return;
        }

        isEmirleri.forEach((item, index) => {
            let tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${item.no}</strong></td>
                <td>${item.malzeme}</td>
                <td>${item.musteri}</td>
                <td>${item.kesim} (${item.adet} Adet)</td>
                <td><svg id="barcode-${index}"></svg></td>
            `;
            tbody.appendChild(tr);

            // Her satır için barkod çizdir
            setTimeout(() => {
                JsBarcode(`#barcode-${index}`, item.no, {
                    format: "CODE128",
                    width: 1.2,
                    height: 30,
                    displayValue: true,
                    fontSize: 10
                });
            }, 50);
        });
    }

    // Form gönderildiğinde veri üret
    document.getElementById('isEmriForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const yeniIsEmri = {
            no: "IE-" + Math.floor(100000 + Math.random() * 900000), // Rastgele iş emri no
            malzeme: document.getElementById('malzemeAdi').value,
            musteri: document.getElementById('musteriAdi').value,
            kesim: document.getElementById('kesimOlcusu').value,
            adet: document.getElementById('adet').value
        };

        isEmirleri.unshift(yeniIsEmri); // En üste ekle
        localStorage.setItem('metal_is_emirleri', JSON.stringify(isEmirleri)); // Tarayıcıda sakla

        listeyiGoster();
        this.reset(); // Formu temizle
    });

    // İlk yüklemede listeyi çalıştır
    listeyiGoster();
</script>

</body>
</html>