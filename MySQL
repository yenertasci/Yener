-- Metal Stok Tablosu
CREATE TABLE metal_stok (
    id INT AUTO_INCREMENT PRIMARY KEY,
    malzeme_adi VARCHAR(100), -- Örn: 3mm DKP Sac, 40x40 Profil
    kalite VARCHAR(50),       -- Örn: ST37, AISI 304
    en_mm INT,                -- Genişlik
    boy_mm INT,               -- Uzunluk
    kalinlik_mm DECIMAL(5,2), -- Kalınlık
    stok_miktari INT,         -- Plaka / Boy Adedi
    birim_agirlik_kg DECIMAL(8,2)
);

-- İş Emirleri Tablosu
CREATE TABLE is_emirleri (
    id INT AUTO_INCREMENT PRIMARY KEY,
    is_emri_no VARCHAR(20) UNIQUE,
    stok_id INT,
    musteri_adi VARCHAR(100),
    kesim_olcusu VARCHAR(100), -- Örn: 500x1000 mm
    kullanilan_adet INT,
    durum ENUM('Bekliyor', 'Kesimde', 'Tamamlandı') DEFAULT 'Bekliyor',
    tarih TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (stok_id) REFERENCES metal_stok(id)
);