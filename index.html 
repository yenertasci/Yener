        let catalogData = JSON.parse(localStorage.getItem('tasarruf_catalog')) || initialCatalog;

        function renderDefter() {
            const container = document.getElementById('defterAkisi');
            container.innerHTML = '';

            // 1. KAPAK SAYFASI
            const coverDiv = document.createElement('div');
            coverDiv.className = "bg-slate-900 border border-emerald-500/40 p-8 lg:p-12 rounded-2xl shadow-2xl space-y-6 text-center relative overflow-hidden";
            coverDiv.innerHTML = `
                <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px]"></div>
                <div class="relative z-10 space-y-4">
                    <span class="bg-emerald-500 text-slate-950 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-widest">Resmî Tasarım ve Ar-Ge Defteri</span>
                    <h2 class="text-3xl lg:text-5xl font-black text-white tracking-tight">TASARRUF DEVRİ & SIFIR ATIK</h2>
                    <p class="text-slate-300 max-w-2xl mx-auto text-sm leading-relaxed">
                        Bu defter; ülkemizin enerji bağımsızlığından sıfır atık hedeflerine, akıllı şebekelerden dijital devlet uygulamalarına kadar uzanan 18 stratejik hamleyi tüm detayları, gerekçeleri ve gelecek vizyonuyla alt alta incelemeniz için hazırlanmıştır.
                    </p>
                    <div class="pt-6 border-t border-slate-800 flex flex-wrap justify-center items-center text-xs text-slate-400 gap-6">
                        <span>Sorumlu Yöneticiler: <strong class="text-slate-200">Yener & Oktay</strong></span>
                        <span>•</span>
                        <span class="text-emerald-400 font-mono">Arşiv Sürümü: 2026.1</span>
                    </div>
                </div>
            `;
            container.appendChild(coverDiv);

            // 2. 18 DETAYLI SAYFA
            catalogData.forEach((item, idx) => {
                const pageNum = idx + 1;
                const pageDiv = document.createElement('div');
                pageDiv.className = "bg-slate-900 border border-slate-800 rounded-2xl p-6 lg:p-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-start shadow-xl";
                pageDiv.innerHTML = `
                    <div class="md:col-span-5 relative sticky top-24">
                        <img src="${item.img}" alt="${item.titleTr}" class="w-full h-64 object-cover rounded-xl border border-slate-800 shadow-md">
                        <span class="absolute top-3 left-3 bg-slate-950/95 backdrop-blur text-emerald-400 text-xs font-bold px-3 py-1 rounded border border-emerald-500/30 shadow">${item.cat}</span>
                    </div>
                    <div class="md:col-span-7 space-y-5">
                        <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                            <span class="text-xs font-mono text-emerald-400 font-bold uppercase tracking-wider">YAPRAK NO: ${pageNum} / 18</span>
                        </div>
                        <div class="space-y-2">
                            <div class="flex items-center gap-2">
                                <span class="bg-emerald-500/20 text-emerald-400 text-[11px] font-bold px-2.5 py-0.5 rounded border border-emerald-500/30">TR</span>
                                <h3 class="text-lg lg:text-xl font-bold text-white">${item.titleTr}</h3>
                            </div>
                            <div class="text-slate-300 text-xs lg:text-sm leading-relaxed pl-7 space-y-2 border-l-2 border-emerald-500/30 ml-2 py-1">
                                ${item.descTr}
                            </div>
                        </div>
                        <div class="space-y-2 pt-3 border-t border-slate-800/80">
                            <div class="flex items-center gap-2">
                                <span class="bg-cyan-500/20 text-cyan-400 text-[11px] font-bold px-2.5 py-0.5 rounded border border-cyan-500/30">EN</span>
                                <h4 class="text-sm font-semibold text-slate-200">${item.titleEn}</h4>
                            </div>
                            <p class="text-slate-400 text-xs leading-relaxed pl-7 border-l-2 border-cyan-500/30 ml-2 py-1">${item.descEn}</p>
                        </div>
                    </div>
                `;
                container.appendChild(pageDiv);
            });
        }

        // WINAMP AUDIO CONTROLS
        const audio = document.getElementById('audioPlayer');
        let timer = null;

        function playAudio() {
            audio.play().then(() => {
                document.getElementById('playStateBadge').innerText = "YAYINDA";
                document.getElementById('playStateBadge').className = "text-xs text-emerald-400 font-mono-winamp font-bold animate-pulse";
                if (!timer) timer = setInterval(updateTime, 1000);
            }).catch(e => alert("Tarayıcı kısıtlaması nedeniyle oynatılamadı. Lütfen tekrar deneyin."));
        }

        function pauseAudio() {
            audio.pause();
            document.getElementById('playStateBadge').innerText = "DURAKLATILDI";
            document.getElementById('playStateBadge').className = "text-xs text-amber-400 font-mono-winamp font-bold";
        }

        function toggleMute() {
            audio.muted = !audio.muted;
            document.getElementById('muteBtn').innerText = audio.muted ? "Sesi Aç" : "Sesi Kıs";
        }

        function changeStation(url, title) {
            audio.src = url;
            audio.load();
            document.getElementById('trackTitleDisplay').innerText = title;
            playAudio();
        }

        function updateTime() {
            if (!audio.paused) {
                const c = Math.floor(audio.currentTime);
                const m = Math.floor(c / 60).toString().padStart(2, '0');
                const s = (c % 60).toString().padStart(2, '0');
                document.getElementById('timeDisplay').innerText = `${m}:${s}`;
            }
        }

        // ADMIN MODAL
        function toggleAdminModal() { document.getElementById('adminModal').classList.toggle('hidden'); }
        function loginAdmin() {
            const u = document.getElementById('adminUser').value.trim().toLowerCase();
            const p = document.getElementById('adminPass').value.trim();
            if ((u === "yener" || u === "oktay") && p === "123456") {
                alert("Giriş Başarılı! Yener & Oktay Yönetici Paneli onaylandı.");
                toggleAdminModal();
            } else {
                alert("Hatalı kullanıcı adı veya şifre! (Şifre: 123456)");
            }
        }

        window.onload = renderDefter;
    </script>
</body>
